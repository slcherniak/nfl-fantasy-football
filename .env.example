# Yahoo auth: full Cookie header from a logged-in browser session
# (F12 -> Network -> request to football.fantasysports.yahoo.com -> Request
# Headers -> Cookie). Sessions expire after some weeks; refresh on
# CookiesExpiredError. In CI this lives in the YAHOO_COOKIES secret.
YAHOO_COOKIES=

# Yahoo league (also in config.yaml; env wins if both set)
LEAGUE_ID=392520

# Google Sheets
SHEET_ID=
# Either a path to the service-account JSON file...
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# ...or the JSON itself (used in CI, takes precedence if set)
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- API mode only (--source api; requires approved Yahoo Fantasy API
# access via sports.yahoo.com/developer/access) ---
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
YAHOO_ACCESS_TOKEN_JSON=
