# Yahoo Developer app credentials (developer.yahoo.com -> My Apps)
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
# Filled automatically after the one-time browser OAuth dance (yfpy writes the
# refreshed token back here every run when save_token_data_to_env_file is on).
YAHOO_ACCESS_TOKEN_JSON=

# Yahoo league (also in config.yaml; env wins if both set)
LEAGUE_ID=392520

# Google Sheets
SHEET_ID=
# Either a path to the service-account JSON file...
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# ...or the JSON itself (used in CI, takes precedence if set)
GOOGLE_SERVICE_ACCOUNT_JSON=
